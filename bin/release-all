#!/usr/bin/env ruby

require 'thor'

class CoreBumpCLI < Thor
  desc "release", "Build ruby gems & npm packages and push them to their respective platforms."
  option :allow_local
  def release
    if !github_output_file && !options[:allow_local]
      banner = <<~BANNER
        --------------------------------------------------------------------------------------------------------
        - It looks like you're running this scirpt locally.
        - This script was designed to run as part of a GitHub workflow.
        - We don't recommend using this script locally to directly publish gems and packages.
        -
        - You can run the workflow by going here:
        - https://github.com/bullet-train-co/bullet_train-core/actions/workflows/version-bump.yml
        -
        - If you really want to run this locally you should make sure you're not on the `main` branch,
        - and then you can pass the `--allow-local` flag to skip this notice and run the script.
        -
        - For example:
        - ./bin/release-all --allow-local
        -------------------------------------------------------------------------------------------------------
      BANNER
      say_error banner, :red
      return
    end

    puts output = `bump current`
    @version = output.chomp.lines.last.chomp
    "Releasing version: #{@version}"

    @failures = []

    release_ruby_gems
    release_npm_packages
    write_to_github_output_file
    report_failures
  end

  # This allows failure to be reported to the shell correctly.
  # https://github.com/rails/thor/wiki/Making-An-Executable
  def self.exit_on_failure?
    true
  end

  # This allows us to define helper methods that aren't attached to thor commands
  no_commands do
    def github_output_file
      ENV['GITHUB_OUTPUT']
    end

    def release_ruby_gems
      ruby_gems.each do |package|
        puts "releasing package: #{package}"
        Dir.chdir "./#{package}"

        puts output = `gem build`
        unless $?.success?
          record_failure package, "`gem build` failed"
          Dir.chdir ".."
          next
        end

        gem_file = output.chomp.lines.last.chomp.split.last
        puts "Built gem file: #{gem_file}"

        # `gem push` reports permission and MFA problems on stderr, so we merge it into the
        # captured output to tell "already published" apart from a genuine failure.
        puts output = `gem push #{gem_file} 2>&1`
        push_succeeded = $?.success?

        File.delete(gem_file)

        if !push_succeeded
          if already_published?(output)
            puts "#{package} #{@version} is already on rubygems.org. Skipping."
          else
            record_failure package, "`gem push` failed"
          end
        end

        Dir.chdir ".."

      end
    end

    def release_npm_packages
      npm_packages.each do |package|
        puts "releasing npm package: #{package}"
        Dir.chdir "./#{package}"

        puts `corepack enable`
        puts `yarn`
        puts `yarn build`
        unless $?.success?
          record_failure package, "`yarn build` failed"
          Dir.chdir ".."
          next
        end

        puts output = `yarn pack`

        #puts output = `yarn npm publish --access public`
        puts output = `npm publish --provenance --access public 2>&1`

        if !$?.success?
          if already_published?(output)
            puts "#{package} #{@version} is already on npmjs.com. Skipping."
          else
            record_failure package, "`npm publish` failed"
          end
        end

        Dir.chdir ".."
      end
    end

    # A re-run of this script after a partial failure will re-attempt every package, so a
    # registry rejecting a version we already published is expected and must not fail the build.
    def already_published?(output)
      output.match?(/Repushing of gem versions is not allowed/i) ||
        output.match?(/cannot publish over the previously published version/i)
    end

    def record_failure(package, message)
      say_error "#{message} for #{package}.", :red
      @failures << "#{package}: #{message}"
    end

    # Without this the script exits 0 even when pushes were rejected, and the workflow reports
    # a green release that never actually published some of the packages.
    def report_failures
      return if @failures.empty?

      say_error "\nThe following packages were NOT published:", :red
      @failures.each { |failure| say_error "  - #{failure}", :red }
      exit 1
    end

    def write_to_github_output_file
      if github_output_file
        puts "The new version to pass to the GitHub output file = #{@version}"
        IO.write(github_output_file, "NEW_VERSION_NUMBER=#{@version}\n", mode: 'a')
      else
        say "We don't seem to be running in GitHub actions. Skipping the GitHub output file."
      end
    end

    def ruby_gems
      Dir.glob("*/*.gemspec").map{|gemspec| gemspec.split("/").first }
    end

    def npm_packages
      Dir.glob("*/package.json").map{|package| package.split("/").first }
    end
  end
end

# We create our own args array so that we don't have to ask the user to include `release` on the command line
args = ["release"] + ARGV

CoreBumpCLI.start(args)
